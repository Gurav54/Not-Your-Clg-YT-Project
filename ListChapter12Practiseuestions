#Question 1: Count Even and Odd Numbers
data = [1,2,3,4,5,7,8]
evenSum =0
oddsum=0
if not data:
    print("List is empty")
else:
    for i in data:
        if i %2==0:
            evenSum =evenSum+1
        else:
            oddsum=oddsum+1
    print (f"even sum is = {evenSum} AND odd sum is ={oddsum}")

